# =============================================================================
# PHP-Hyperion Root Git Ignore
# =============================================================================

# Rust Compilation & Target
php-hyperion/target/
**/target/
Cargo.lock.backup
*.rs.bk

# OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
.*.swp

# Laravel Framework Files
**/storage/logs/*.log
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitignore
**/storage/framework/cache/*
!**/storage/framework/cache/.gitignore
**/storage/framework/testing/*
!**/storage/framework/testing/.gitignore

# Dependencies & Package Managers
vendor/
**/vendor/
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Excluded from upload as requested by user
php-hyperion/
frameworks/
docs/
*.log
**/*.log

# SQLite Lock & Journal Files
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Tests & Caches
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
coverage/
*.coverage

# Temporary files
/tmp/
scratch/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.ips
*.tar.gz
*.tgz

