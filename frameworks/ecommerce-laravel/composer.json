{
    "name": "hyperion/ecommerce-laravel",
    "description": "Full E-Commerce project built with Laravel 11 from scratch for PHP-Hyperion benchmarks",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^11.38"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
