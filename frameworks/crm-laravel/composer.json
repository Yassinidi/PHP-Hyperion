{
    "name": "hyperion/crm-laravel",
    "description": "Enterprise CRM built with Laravel 11 for Hyperion Universal Drop-In Validation",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^11.38"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
