u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.","\u064a\u0648\u0641\u0651\u0631 \u0642\u0627\u0644\u0628\u0643 \u0645\u0646\u0637\u0642\u0629 \"\u0645\u0643\u0648\u0651\u0646\u0627\u062a\" \u0648\u0627\u062d\u062f\u0629 (%s) \u0645\u0646 \u0623\u062c\u0644\u0643 \u0644\u0643\u064a \u062a\u0636\u064a\u0641 \u0623\u0648 \u062a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u062d\u0627\u0648\u0644 \u0625\u0636\u0627\u0641\u0629 \u0634\u0631\u064a\u0637 \u0628\u062d\u062b\u060c \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.","\u064a\u0648\u0641\u0651\u0631 \u0642\u0627\u0644\u0628\u0643 %s \u0645\u0646 \u0645\u0646\u0627\u0637\u0642\"\u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a\" \u0645\u0646 \u0623\u062c\u0644\u0643 \u0644\u0643\u064a \u062a\u0636\u064a\u0641 \u0623\u0648 \u062a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u062d\u0627\u0648\u0644 \u0625\u0636\u0627\u0641\u0629 \u0634\u0631\u064a\u0637 \u0628\u062d\u062b\u060c \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.","\u064a\u0648\u0641\u0651\u0631 \u0642\u0627\u0644\u0628\u0643 %s \u0645\u0646\u0627\u0637\u0642 \"\u0645\u0643\u0648\u0651\u0646\u0627\u062a\" \u0645\u0646 \u0623\u062c\u0644\u0643 \u0644\u0643\u064a \u062a\u0636\u064a\u0641 \u0623\u0648 \u062a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u062d\u0627\u0648\u0644 \u0625\u0636\u0627\u0641\u0629 \u0634\u0631\u064a\u0637 \u0628\u062d\u062b\u060c \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.","\u064a\u0648\u0641\u0651\u0631 \u0642\u0627\u0644\u0628\u0643 %s \u0645\u0646\u0637\u0642\u0629 \"\u0645\u0643\u0648\u0651\u0646\u0627\u062a\" \u0645\u0646 \u0623\u062c\u0644\u0643 \u0644\u0643\u064a \u062a\u0636\u064a\u0641 \u0623\u0648 \u062a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u062d\u0627\u0648\u0644 \u0625\u0636\u0627\u0641\u0629 \u0634\u0631\u064a\u0637 \u0628\u062d\u062b\u060c \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643.","\u064a\u0648\u0641\u0651\u0631 \u0642\u0627\u0644\u0628\u0643 %s \u0645\u0646\u0637\u0642\u0629 \"\u0645\u0643\u0648\u0651\u0646\u0627\u062a\" \u0645\u0646 \u0623\u062c\u0644\u0643 \u0644\u0643\u064a \u062a\u0636\u064a\u0641 \u0623\u0648 \u062a\u0642\u0648\u0645 \u0628\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u062d\u0627\u0648\u0644 \u0625\u0636\u0627\u0641\u0629 \u0634\u0631\u064a\u0637 \u0628\u062d\u062b\u060c \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629\u060c \u0623\u0648 \u0623\u0646\u0645\u0627\u0637 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0647\u0646\u0627 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u0633\u062a\u0628\u062f\u0648 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643."],"Widgets footer":["\u062a\u0630\u064a\u064a\u0644 \u0627\u0644\u0648\u062f\u062c\u0627\u062a"],"Widgets and blocks":["\u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a"],"Widgets top bar":["\u0627\u0644\u0634\u0631\u064a\u0637 \u0627\u0644\u0639\u0644\u0648\u064a \u0644\u0644\u0648\u062f\u062c\u0627\u062a"],"Display block breadcrumbs deactivated":["\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0639\u0631\u0636 \u0645\u0643\u0648\u0651\u0646 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0646\u0642\u0651\u0644"],"Display block breadcrumbs activated":["\u062a\u0645 \u062a\u0641\u0639\u064a\u0644 \u0639\u0631\u0636 \u0645\u0643\u0648\u0651\u0646 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0646\u0642\u0651\u0644"],"Saving\u2026":["\u062c\u0627\u0631\u064a \u0627\u0644\u062d\u0641\u0638\u2026"],"Widget Areas":["\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0648\u062f\u062c\u0627\u062a"],"Manage with live preview":["\u0625\u062f\u0627\u0631\u0629 \u0645\u0639 \u0645\u0639\u0627\u064a\u0646\u0629 \u062d\u064a\u0651\u0629"],"Your theme does not contain any Widget Areas.":["\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0642\u0627\u0644\u0628\u0643 \u0639\u0644\u0649 \u0623\u064a \u0645\u0646\u0627\u0637\u0642 \u0648\u062f\u062c\u0627\u062a."],"Blocks in this Widget Area will not be displayed in your site.":["\u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0647\u0630\u0647 \u0644\u0646 \u064a\u062a\u0645 \u0639\u0631\u0636\u0647\u0627 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643."],"Widget Areas are global parts in your site\u2019s layout that can accept blocks. These vary by theme, but are typically parts like your Sidebar or Footer.":["\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0647\u064a \u0623\u062c\u0632\u0627\u0621 \u0639\u0627\u0645\u0629 \u0636\u0645\u0646 \u062a\u062e\u0637\u064a\u0637 \u0645\u0648\u0642\u0639\u0643\u060c \u0648\u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0642\u0628\u0644 \u0648\u062c\u0648\u062f \u0645\u0643\u0648\u0651\u0646\u0627\u062a. \u0648\u0647\u064a \u062a\u062e\u062a\u0644\u0641 \u0628\u062d\u0633\u0628 \u0627\u0644\u0642\u0627\u0644\u0628\u060c \u0644\u0643\u0646\u0647\u0627 \u0639\u0627\u062f\u0629 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0623\u062c\u0632\u0627\u0621 \u0645\u062b\u0644\u0647\u0627 \u0645\u062b\u0644 \u0627\u0644\u0634\u0631\u064a\u0637 \u0627\u0644\u062c\u0627\u0646\u0628\u064a \u0623\u0648 \u0627\u0644\u062a\u0630\u064a\u064a\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643."],"A widget area container.":["\u062d\u0627\u0648\u064a\u0629 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0648\u062f\u062c\u0627\u062a."],"Widget Area":["\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0648\u062f\u062c\u0627\u062a"],"Could not save the following widgets: %s.":["\u062a\u0639\u0630\u0651\u064e\u0631 \u062d\u0641\u0638 \u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629: %s."],"There was an error. %s":["\u062d\u062f\u062b \u062e\u0637\u0623. %s"],"Widgets saved.":["\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0648\u062f\u062c\u0627\u062a."],"Generic label for block inserter button\u0004Block Inserter":["\u0623\u062f\u0627\u0629 \u0625\u062f\u0631\u062c \u0627\u0644\u0645\u0643\u0648\u0651\u0646"],"Get the Classic Widgets plugin.":["\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0625\u0636\u0627\u0641\u0629 Classic Widgets \u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629."],"https:\/\/wordpress.org\/plugins\/classic-widgets\/":["https:\/\/ar.wordpress.org\/plugins\/classic-widgets\/"],"Want to stick with the old widgets?":["\u062a\u0631\u063a\u0628 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0648\u062f\u062c\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u061f"],"You can now add any block to your site\u2019s widget areas. Don\u2019t worry, all of your favorite widgets still work flawlessly.":["\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0622\u0646 \u0625\u0636\u0627\u0641\u0629 \u0623\u064a \u0645\u064f\u0643\u0648\u0651\u0646 \u0625\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0648\u062f\u062c\u0627\u062a \u0645\u0648\u0642\u0639\u0643. \u0644\u0627 \u062a\u0642\u0644\u0642\u060c \u0641\u0643\u0644 \u0648\u062f\u062c\u0627\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0644\u0627 \u062a\u0634\u0648\u0628\u0647\u0627 \u0634\u0627\u0626\u0628\u0629\u060c \u0648\u0644\u0627 \u062a\u0632\u0627\u0644 \u062a\u0639\u0645\u0644 \u0628\u0634\u0643\u0644 \u062e\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0639\u064a\u0648\u0628."],"Welcome to block Widgets":["\u0623\u0647\u0644\u0627\u064b \u0628\u0643 \u0641\u064a \u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0627\u0644\u0648\u062f\u062c\u0627\u062a"],"Contain text cursor inside block deactivated":["\u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0624\u0634\u0631 \u0646\u0635 \u0628\u062f\u0627\u062e\u0644 \u0645\u0643\u0648\u0651\u0646 \u0645\u0639\u0637\u0651\u0644"],"Contain text cursor inside block activated":["\u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0624\u0634\u0631 \u0646\u0635 \u0628\u062f\u0627\u062e\u0644 \u0645\u0643\u0648\u0651\u0646 \u0645\u0641\u0639\u0651\u0644"],"Widgets settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0648\u062f\u062c\u0627\u062a"],"Block Library":["\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a"],"Display block breadcrumbs":["\u0639\u0631\u0636 \u0645\u0643\u0648\u0651\u0646 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0646\u0642\u0651\u0644"],"Shows block breadcrumbs at the bottom of the editor.":["\u0625\u0638\u0647\u0627\u0631 \u0645\u0643\u0648\u0651\u0646 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0646\u0642\u0651\u0644 \u0641\u064a \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0633\u0641\u0644\u064a \u0645\u0646 \u0627\u0644\u0645\u062d\u0631\u0631."],"Use theme styles":["\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0646\u0633\u064a\u0642\u0627\u062a \u0627\u0644\u0642\u0627\u0644\u0628"],"Make the editor look like your theme.":["\u062c\u0639\u0644 \u0627\u0644\u0645\u062d\u0631\u0631 \u064a\u0628\u062f\u0648 \u0645\u062b\u0644 \u0642\u0627\u0644\u0628\u0643."],"Aids screen readers by stopping text caret from leaving blocks.":["\u0645\u0633\u0627\u0639\u062f\u0629 \u0642\u0627\u0631\u0626 \u0627\u0644\u0634\u0627\u0634\u0629 \u0628\u0625\u064a\u0642\u0627\u0641 \u0625\u0642\u062d\u0627\u0645 \u0627\u0644\u0646\u0635 \u0645\u0646 \u0645\u063a\u0627\u062f\u0631\u0629 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a."],"Preferences":["\u0627\u0644\u062a\u0641\u0636\u064a\u0644\u0627\u062a"],"Contain text cursor inside block":["\u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0624\u0634\u0631 \u0646\u0635 \u0628\u062f\u0627\u062e\u0644 \u0645\u0643\u0648\u0651\u0646"],"All of the blocks available to you live in the block library. You\u2019ll find it wherever you see the <InserterIconImage \/> icon.":["\u0633\u062a\u062c\u062f \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0623\u0645\u0627\u0645\u0643 \u0641\u064a \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a. \u0633\u062a\u062c\u062f\u0647\u0627 \u0623\u064a\u0646\u0645\u0627 \u062a\u0631\u0649 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629 <InserterIconImage \/>."],"Each block comes with its own set of controls for changing things like color, width, and alignment. These will show and hide automatically when you have a block selected.":["\u064a\u0623\u062a\u064a \u0643\u0644 \u0645\u0643\u0648\u0651\u0646 \u0628\u0645\u062c\u0645\u0648\u0639\u0629 \u062e\u0627\u0635\u0629 \u0645\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0644\u0648\u0646 \u0648\u0627\u0644\u0639\u0631\u0636\u060c \u0648\u0627\u0644\u0645\u062d\u0627\u0630\u0627\u0629. \u0633\u062a\u0638\u0647\u0631 \u0647\u0630\u0647 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0648\u062a\u062e\u062a\u0641\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u064a\u0643\u0648\u0646 \u0644\u062f\u064a\u0643 \u0645\u0643\u0648\u0651\u0646 \u0645\u064f\u062d\u062f\u0651\u064e\u062f."],"Get started":["\u0627\u0644\u0628\u062f\u0621"],"inserter":["\u0623\u062f\u0627\u0629 \u0627\u0644\u0625\u062f\u0631\u0627\u062c"],"Welcome Guide":["\u0627\u0644\u062f\u0644\u064a\u0644 \u0627\u0644\u062a\u0631\u062d\u064a\u0628\u064a"],"Keyboard shortcuts":["\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d"],"Display these keyboard shortcuts.":["\u0639\u0631\u0636 \u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0647\u0630\u0647."],"Top toolbar deactivated":["\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0639\u0644\u0648\u064a"],"Top toolbar activated":["\u062a\u0645\u0651 \u062a\u0641\u0639\u064a\u0644 \u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0639\u0644\u0648\u064a"],"Top toolbar":["\u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0639\u0644\u0648\u064a"],"Close Settings":["\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"],"Pin to toolbar":["\u0627\u0644\u062a\u062b\u0628\u064a\u062a \u0625\u0644\u0649 \u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a"],"Unpin from toolbar":["\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u062b\u0628\u064a\u062a \u0645\u0646 \u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a"],"Close plugin":["\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0625\u0636\u0627\u0641\u0629"],"Remove a link.":["\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0631\u0627\u0628\u0637."],"Convert the selected text into a link.":["\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u064f\u062d\u062f\u062f \u0625\u0644\u0649 \u0631\u0627\u0628\u0637."],"Underline the selected text.":["\u0648\u0636\u0639 \u062e\u0637 \u062a\u062d\u062a \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u064f\u062d\u062f\u062f."],"Make the selected text italic.":["\u0627\u062c\u0639\u0644 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u064f\u062d\u062f\u062f \u0645\u0627\u0626\u0644\u0627\u064b."],"Make the selected text bold.":["\u0627\u062c\u0639\u0644 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u064f\u062d\u062f\u062f \u0639\u0631\u064a\u0636\u064b\u0627."],"Text formatting":["\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0646\u0635"],"Forward-slash":["\u062e\u0637 \u0645\u0627\u0626\u0644"],"Change the block type after adding a new paragraph.":["\u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0643\u0648\u0651\u0646 \u0628\u0639\u062f \u0625\u0636\u0627\u0641\u0629 \u0641\u0642\u0631\u0629 \u062c\u062f\u064a\u062f\u0629."],"Block shortcuts":["\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0627\u062a"],"Selection shortcuts":["\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u062d\u062f\u064a\u062f"],"Navigate to the previous part of the editor.":["\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0633\u0627\u0628\u0642 \u0645\u0646 \u0627\u0644\u0645\u064f\u062d\u0631\u0631."],"Navigate to the next part of the editor.":["\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u062a\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0645\u064f\u062d\u0631\u0631."],"Redo your last undo.":["\u0625\u0639\u0627\u062f\u0629 \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644\u0627\u062a\u0643."],"Undo your last changes.":["\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644\u0627\u062a\u0643."],"Save your changes.":["\u062d\u0641\u0638 \u062a\u0639\u062f\u064a\u0644\u0627\u062a\u0643."],"Global shortcuts":["\u0627\u062e\u0646\u0635\u0627\u0631\u0627\u062a \u0639\u0627\u0645\u0629"],"Access all block and document tools in a single place":["\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u062c\u0645\u064a\u0639 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0645\u0643\u0648\u0651\u0646 \u0648\u0627\u0644\u0645\u0633\u062a\u0646\u062f \u0641\u064a \u0645\u0643\u0627\u0646 \u0648\u0627\u062d\u062f"],"noun\u0004View":["\u0627\u0644\u0639\u0631\u0636"],"Options":["\u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a"],"Document tools":["\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0646\u062f"],"You have unsaved changes. If you proceed, they will be lost.":["\u0644\u062f\u064a\u0643 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u063a\u064a\u0631 \u0645\u062d\u0641\u0648\u0638\u0629. \u0625\u0630\u0627 \u0642\u0645\u062a \u0628\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u060c \u0641\u0633\u064a\u062a\u0645 \u0641\u0642\u062f\u0627\u0646\u0647\u0627."],"The editor has encountered an unexpected error.":["\u0648\u0627\u062c\u0647 \u0627\u0644\u0645\u062d\u0631\u0631 \u062e\u0637\u0623 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639."],"Copy Error":["\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0646\u0633\u062e"],"No block selected.":["\u0644\u0645 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0623\u064a \u0645\u0643\u0648\u0651\u0646."],"(opens in a new tab)":["(\u064a\u064f\u0641\u062a\u062d \u0641\u064a \u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f\u0629)"],"List View":["\u0639\u0631\u0636 \u0643\u0642\u0627\u0626\u0645\u0629"],"Tools":["\u0623\u062f\u0648\u0627\u062a"],"Footer":["\u062a\u0630\u064a\u064a\u0644"],"Block":["\u0627\u0644\u0645\u0643\u0648\u0651\u0646"],"Learn more":["\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f"],"Widgets":["\u0648\u062f\u062c\u0627\u062a"],"Settings":["\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"],"Help":["\u0645\u0633\u0627\u0639\u062f\u0629"],"Close":["\u0625\u063a\u0644\u0627\u0642"],"Update":["\u062a\u062d\u062f\u064a\u062b"],"Redo":["\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0631\u0627\u062c\u0639"],"Content":["\u0627\u0644\u0645\u062d\u062a\u0648\u0649 "],"Publish":["\u0646\u0634\u0631"],"Undo":["\u062a\u0631\u0627\u062c\u0639"]}},"comment":{"reference":"wp-includes\/js\/dist\/edit-widgets.js"}}